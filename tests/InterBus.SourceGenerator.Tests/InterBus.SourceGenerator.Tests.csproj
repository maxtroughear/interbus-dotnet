<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.*" />
    <PackageReference Include="xunit" Version="2.9.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Roslyn APIs for creating test compilations and running the generator. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.*" />
  </ItemGroup>
  <ItemGroup>
    <!-- InterBus: needed to resolve typeof(IConsumer).Assembly.Location in test helpers. -->
    <ProjectReference Include="..\..\src\InterBus\InterBus.csproj" />
    <!-- SourceGenerator: referenced directly (not as Analyzer) so we can instantiate it in tests. -->
    <ProjectReference Include="..\..\src\InterBus.SourceGenerator\InterBus.SourceGenerator.csproj" />
  </ItemGroup>
</Project>

        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13"/>
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.13"/>
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="xunit.v3" Version="4.0.2"/>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\src\InterBus\InterBus.csproj"/>
